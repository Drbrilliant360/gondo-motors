{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/copy-assets.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": { "maxDuration": 30, "excludeFiles": "{src/assets/**,public/**,dist/**,.pgdata/**}" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "headers": [
    { "source": "/assets/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/assets/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }] }
  ]
}
