# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Neon: use the *pooled* connection string (host contains "-pooler") with sslmode=require.
# For local development without Neon, run `npm run db:local` and use:
#   DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
DATABASE_URL=

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=

# Default admin created by `npm run seed`. The admin must change this password on first login.
ADMIN_NAME=Gondo Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public address of the site, used in password-reset emails and WhatsApp order links.
SITE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Password-reset emails. Leave SMTP_HOST empty in development: the reset link is printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gondo Motors <no-reply@gondomotors.com>

# Cloudinary (vehicle photos, payment proofs, order documents) — needed from the admin vehicles step onward.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
