{
  "name": "gondo-motors",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Gondo Motors — redesigned car marketplace (static site generator, Express + Neon Postgres)",
  "scripts": {
    "data": "node scripts/prepare-data.mjs",
    "images": "node scripts/optimize-images.mjs ../gondomotors-clone",
    "build": "node build/build.mjs",
    "vercel-build": "node scripts/copy-assets.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "node build/build.mjs && node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "db:local": "node scripts/db-local.mjs",
    "migrate": "node scripts/migrate.mjs",
    "import:cars": "node scripts/import-cars.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "sharp": "^0.35.5"
  }
}
